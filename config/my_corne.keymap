#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
/* Rad 0 (Øverste rad - 14 taster) */
&kp TAB    &kp Q        &kp W        &kp E         &kp R        &kp T  &kp LBKT        &kp RBKT  &kp Y  &kp U        &kp I         &kp O        &kp P           &kp BSPC
/* Rad 1 (Home Row Mods: A/S/D/F speilet til J/K/L/SEMI) */
&kp LCTRL  &hm LCTRL A  &hm LALT S   &hm LSHFT D   &hm LGUI F   &kp G  &kp LBRC        &kp RBRC  &kp H  &hm RGUI J   &hm RSHFT K   &hm RALT L   &hm RCTRL SEMI  &kp SQT
/* Rad 2 (Nederste rad - 14 taster: MUTE-klikk til venstre, PLAY/PAUSE-klikk til høyre) */
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V        &kp B  &kp C_MUTE      &kp C_PP  &kp N  &kp M        &kp COMMA     &kp DOT      &kp FSLH        &kp ESC
/* Rad 3 (Tommelrad) */
                                     &mo 1         &lt 1 ESC    &kp SPACE              &kp RET   &kp BSPC  &mo 2
            >;

            /* Høyre encoder treffer indeks 0 -> Opp/Ned pil først */
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };

        lower_layer {
            bindings = <
/* Rad 0 (Symboler på QWERT og YUIOP,  på posisjonen til ) */
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp RBKT    &trans  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &trans
/* Rad 1 (Tall på ASDFG og HJKLØ) */
&trans  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans      &trans  &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
/* Rad 2 */
&trans  &trans    &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans    &trans
/* Rad 3 */
                            &trans    &trans    &trans                &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            bindings = <
/* Rad 0 (Symboler) */
&trans  &kp EXCL    &kp AT       &kp HASH     &kp DLLR     &kp PRCNT  &trans      &trans  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &trans
/* Rad 1 (Tegn) */
&trans  &trans      &trans       &trans       &trans       &trans     &trans      &trans  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
/* Rad 2 (Bluetooth-profiler og nullstilling) */
&trans  &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans     &trans      &trans  &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
/* Rad 3 */
                                 &trans       &trans       &trans                 &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };
    };
};