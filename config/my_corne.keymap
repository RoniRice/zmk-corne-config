#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
/* Rad 0 (Øverste rad - 14 taster) */
&kp TAB    &kp Q  &kp W  &kp E         &kp R  &kp T  &kp LBKT        &kp RBKT  &kp Y  &kp U  &kp I         &kp O    &kp P     &kp Q
/* Rad 1 (Midterste rad - Raskere respons på D og K) */
&kp LCTRL  &kp A  &kp S  &hm LSHFT D   &kp F  &kp G  &kp LBRC        &kp RBRC  &kp H  &kp J  &hm RSHFT K   &kp L    &kp SEMI  &kp SQT
/* Rad 2 (Nederste rad - 14 taster) */
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V  &kp B  &kp C_MUTE      &kp C_PP  &kp N  &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp ESC
/* Rad 3 (Tommelrad - 6 taster: Hold Backspace for lag 2) */
                         &kp LGUI      &lt 1 ESC  &kp SPACE              &kp RET   &kp BSPC  &lt 2 RALT
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        lower_layer {
            bindings = <
/* Rad 0 (Tallrad) */
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans      &trans  &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
/* Rad 1 (Piltaster) */
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
/* Rad 2 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans    &trans    &trans
/* Rad 3 */
                        &trans  &trans  &trans              &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            bindings = <
/* Rad 0 (Symboler) */
&trans  &kp EXCL    &kp AT       &kp HASH     &kp DLLR     &kp PRCNT  &trans      &trans  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &trans
/* Rad 1 (Tegn) */
&trans  &trans      &trans       &trans       &trans       &trans     &trans      &trans  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
/* Rad 2 (Bluetooth-profiler og nullstilling) */
&trans  &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans     &trans      &trans  &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
/* Rad 3 */
                                 &trans       &trans       &trans                 &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };
    };
};