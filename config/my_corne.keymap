#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp Q        &kp W       &kp E        &kp R       &kp T      &kp LBKT     &kp RBKT   &kp Y    &kp U       &kp I        &kp O       &kp P           &kp LEFT_BRACKET
&kp TAB           &hm LCTRL A  &hm LALT S  &hm LSHFT D  &hm LGUI F  &kp G      &kp LBRC     &kp RBRC   &kp H    &hm RGUI J  &hm RSHFT K  &hm RALT L  &hm RCTRL SEMI  &kp SQT
&kp GREATER_THAN  &kp Z        &kp X       &kp C        &kp V       &kp B      &mkp LCLK    &mkp RCLK  &kp N    &kp M       &kp COMMA    &kp DOT     &kp FSLH        &kp MINUS
                                           &mo 1        &lt 1 ESC   &kp SPACE                          &kp RET  &kp BSPC    &mo 2
            >;

            /* Høyre encoder treffer indeks 0 -> Opp/Ned pil først */

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };

        lower_layer {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp RBKT    &trans  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &trans      &trans  &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans  &trans     &trans    &trans     &trans    &trans    &trans
                          &trans    &trans    &trans                         &trans     &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            bindings = <
&trans  &kp EXCL    &kp AT        &kp HASH      &kp DLLR      &kp PRCNT  &trans    &trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &trans      &trans        &trans        &trans        &trans     &trans    &trans  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans     &trans    &trans  &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                  &trans        &trans        &trans                       &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RIGHT LEFT>;
        };
    };
};
